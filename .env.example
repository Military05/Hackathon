# Read explicitly with --env-file .env; never commit credentials.
LOCAL_LLM_PROVIDER=openai_compatible
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
# Exact local Qwen model id from /v1/models; no guessed default.
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
AGENT_DATABASE=runtime/agent.sqlite
# In A1 use the shared SQLite path and inject CaptureProvider + build_router.
# Development fixture mode is explicit: python -m src.agent.main --fixture ...
# Ollama alternative: provider=ollama, base URL=http://127.0.0.1:11434
# Ollama's installed candidate: LOCAL_LLM_MODEL=qwen3:4b
